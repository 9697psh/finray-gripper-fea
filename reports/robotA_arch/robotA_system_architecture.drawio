FFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=11.0;fontColor=#1A1A1A;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1145.0" y="1358.0" width="175.0" height="64.0" as="geometry" /></mxCell><mxCell id="L_a1_c113" value="&lt;b&gt;사진 · 도착 전송 (recheck)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#1F5FD6&quot;&gt;→ /farm/robot_a/recheck_photo&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#1F5FD6&quot;&gt;→ /farm/robot_a/recheck_arrival&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#1F5FD6&quot;&gt;→ /farm/robot_a/arrival_error&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#666666&quot;&gt;사진 번호 1001부터&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#666666&quot;&gt;→ cmd_audio 알림음&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=11.0;fontColor=#1A1A1A;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1345.0" y="1345.2" width="210.0" height="89.6" as="geometry" /></mxCell><mxCell id="L_a1_c114" value="&lt;b&gt;docking station&lt;br&gt;이동 · 대기&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#1F5FD6&quot;&gt;→ Nav2 · /robot5/dock&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=11.0;fontColor=#1A1A1A;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430.0" y="1470.0" width="150.0" height="50.0" as="geometry" /></mxCell><mxCell id="L_a1_c115" value="재탐색&lt;br&gt;3회 초과?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=10.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="985.0" y="1460.0" width="130.0" height="70.0" as="geometry" /></mxCell><mxCell id="L_a1_c116" value="출발 전 배터리&lt;br&gt;20% 이하?&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#D62728&quot;&gt;/robot5/battery_state&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=10.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1365.0" y="1455.0" width="170.0" height="80.0" as="geometry" /></mxCell><mxCell id="L_a1_c117" value="&lt;b&gt;B&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6A4BB0;strokeWidth=1.3;fontSize=12.0;fontColor=#6A4BB0;" vertex="1" parent="1"><mxGeometry x="1550.0" y="1480.0" width="30.0" height="30.0" as="geometry" /></mxCell><mxCell id="L_a1_c118" value="&lt;b&gt;전 위치로 이동&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#2E7D4F&quot;&gt;→ Nav2: goal&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#999999&quot;&gt;(미구현)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAAAAA;strokeWidth=1.5;fontSize=11.0;fontColor=#999999;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="800.0" y="1580.0" width="150.0" height="50.0" as="geometry" /></mxCell><mxCell id="L_a1_c119" value="현 위치&lt;br&gt;A1?&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#999999&quot;&gt;(미구현)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAAAAA;strokeWidth=1.5;fontSize=10.5;fontColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="985.0" y="1570.0" width="130.0" height="70.0" as="geometry" /></mxCell><mxCell id="L_a1_c120" value="remission_list에&lt;br&gt;남은 좌표?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=10.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1380.0" y="1570.0" width="140.0" height="70.0" as="geometry" /></mxCell><mxCell id="L_a1_c121" value="리스트에&lt;br&gt;좌표 있음?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=10.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1180.0" y="1680.0" width="140.0" height="70.0" as="geometry" /></mxCell><mxCell id="L_a1_c122" value="&lt;b&gt;30초 동안&lt;br&gt;자리에서 수신 대기&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#D62728&quot;&gt;← /robot5/remission_list&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=11.0;fontColor=#1A1A1A;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1370.0" y="1690.0" width="170.0" height="50.0" as="geometry" /></mxCell><mxCell id="L_a1_c123" value="&lt;b&gt;상태 보고 (a_mission)&lt;/b&gt;&lt;br&gt;mission_cmd feedback 1초 · 강제 도킹 응답 /farm/robot_a/cmd_ack&lt;br&gt;위치 · 배터리 · location · work_targets 는 메인 서버가 직접 (11/22 뺌)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FC;strokeColor=#1F5FD6;strokeWidth=1.5;fontSize=9.0;fontColor=#1A1A1A;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1170.0" y="1755.0" width="409.1" height="42.0" as="geometry" /></mxCell><mxCell id="L_a1_c124" value="&lt;b&gt;강제 도킹 (전 과정)&lt;/b&gt;  ← /farm/robot_a/force_dock (Bool) → 즉시 멈춤 · 도킹 · 응답 /farm/robot_a/cmd_ack&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#666666&quot;&gt;비상정지 · 통신 3초 끊김 정지는 미구현 · 배터리는 흐름 안에서 확인&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B58A00;strokeWidth=1.5;fontSize=11.0;fontColor=#1A1A1A;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="430.0" y="1765.0" width="720.0" height="40.0" as="geometry" /></mxCell><mxCell id="L_a1_n1" value="재순찰 목록 있음?&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#D62728&quot;&gt;← /robot5/remission_list&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.0px;color:#666666&quot;&gt;(서비스)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=10.5;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1005.5" y="1153.0" width="170.0" height="80.0" as="geometry" /></mxCell><mxCell id="L_a1_rlist" value="&lt;b&gt;a_remission_list.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#666666&quot;&gt;처음부터 켜 둠 · 임시: 서버 대체&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#D62728&quot;&gt;← /farm/robot_b/arrival (B 도착)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#D62728&quot;&gt;← /farm/robot_a/recheck_photo (재확인 사진)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#1F5FD6&quot;&gt;→ 서비스 /robot5/remission_list&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#D62728&quot;&gt;← /farm/robot_a/arrival_error (첫 순찰 섹터 저장)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#D62728&quot;&gt;← /farm/robot_a/force_next_sector (Bool)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#1F5FD6&quot;&gt;→ /farm/robot_b/work_target (섹터 하나씩)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0FA;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=11.0;fontColor=#1A1A1A;arcSize=12;" vertex="1" parent="1"><mxGeometry x="595.5" y="1459.1" width="236.4" height="113.6" as="geometry" /></mxCell><mxCell id="L_a1_c81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.4;fontSize=9.5;fontColor=#444444;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="L_a1_c58" target="L_a1_c59"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="L_a1_c82" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.4;fontSize=9.5;fontColor=#444444;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="L_a1_c59" target="L_a1_c60"><mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint x="0.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="L_a1_c83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.4;fontSize=9.5;fontColor=#444444;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;" edge