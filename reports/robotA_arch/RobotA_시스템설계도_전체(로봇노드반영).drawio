" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;바퀴 구동 · 주행거리&lt;/b&gt;&lt;br&gt;/cmd_vel 구독 → /odom · TF odom→base_link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.2;fontSize=10;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="48" y="422" width="244" height="38" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;도킹&lt;/b&gt;&lt;br&gt;/dock · /undock 액션 서버 · /dock_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.2;fontSize=10;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="48" y="466" width="244" height="38" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;배터리 · 안전 센서&lt;/b&gt;  /battery_state · /hazard_detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.2;fontSize=10;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="48" y="510" width="244" height="32" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;System Monitor&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#333333;strokeWidth=2;fontSize=13;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="220" height="150" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b&gt;Detect&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;비전 인식 팀 (YOLO)&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#333333;strokeWidth=2;fontSize=13;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1505" width="220" height="70" as="geometry"/></mxCell><mxCell id="c28" value='&lt;b&gt;SERVER&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;&lt;br&gt;작업 지시&lt;br&gt;결과 저장&lt;br&gt;재방문 목록&lt;br&gt;(remission_list)&lt;br&gt;B 작업 상태&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#333333;strokeWidth=2;fontSize=13;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="220" height="620" as="geometry"/></mxCell><mxCell id="c29" value="전달" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D62728;strokeWidth=2;fontSize=10;fontColor=#D62728;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="c28" target="c26"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c30" value="PC  (원격 PC · ROS 2 Jazzy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2.5;fontSize=17;fontStyle=1;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="1320" height="1530" as="geometry"/></mxCell><mxCell id="c31" value='Localization  &lt;span style="font-weight:normal;font-size:12px"&gt;(localization.launch.py · 2개)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#C77700;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#C77700;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="600" height="210" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b&gt;amcl&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;맵 위 로봇 위치 추정&lt;br&gt;구독 /scan · /map · /initialpose&lt;br&gt;발행 /amcl_pose · TF map→odom&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C77700;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="185" width="200" height="80" as="geometry"/></mxCell><mxCell id="c33" value='&lt;b&gt;map_server&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;저장한 맵 (.yaml · .pgm) 불러오기&lt;br&gt;발행 /map&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C77700;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="680" y="185" width="200" height="80" as="geometry"/></mxCell><mxCell id="c34" value='&lt;b&gt;lifecycle_manager_localization&lt;/b&gt;  &lt;span style="font-size:10px"&gt;두 노드 켜기·끄기 (configure → activate)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF3E4;strokeColor=#B8A07A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="282" width="450" height="32" as="geometry"/></mxCell><mxCell id="c35" value='&lt;b&gt;RViz2 (PC)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;2D Pose Estimate로 초기 위치 지정&lt;br&gt;Nav2 Goal · 맵 · 경로 보기&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#777777;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="140" width="230" height="70" as="geometry"/></mxCell><mxCell id="c36" value='Navigation (Nav2)  &lt;span style="font-weight:normal;font-size:12px"&gt;(nav2.launch.py · 10개)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F0;strokeColor=#2E7D4F;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#2E7D4F;align=center;verticalAlign=top;spacingLeft=12;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="1240" height="380" as="geometry"/></mxCell><mxCell id="c37" value='&lt;b&gt;collision_monitor&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;장애물 가까우면 감속·정지&lt;br&gt;cmd_vel_smoothed → /cmd_vel&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D4F;stroke