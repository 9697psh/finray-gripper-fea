  <diagram name="01 System Architecture (장비 구성)" id="0"><mxGraphModel dx="1720" dy="1640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:20px"&gt;로봇 A 시스템 설계도&lt;/b&gt;&lt;span style="font-size:13px;color:#555"&gt;  TurtleBot4 · ROS 2 Jazzy · namespace /robot&amp;lt;n&amp;gt;&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="760" height="30" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D62728;strokeWidth=2;fontSize=10;fontColor=#D62728;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="900" y="28" as="sourcePoint"/><mxPoint x="944" y="28" as="targetPoint"/><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c4" value="외부 → PC (입력)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="952" y="20" width="215" height="16" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1F5FD6;strokeWidth=2;fontSize=10;fontColor=#1F5FD6;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1170" y="28" as="sourcePoint"/><mxPoint x="1214" y="28" as="targetPoint"/><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c6" value="PC → 외부 (출력)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1222" y="20" width="215" height="16" as="ge