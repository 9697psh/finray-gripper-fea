lor=#6A4BB0;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1290" y="1262" width="160" height="56" as="geometry"/></mxCell><mxCell id="c67" value='&lt;b&gt;OAK-D 촬영&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;0.5fps (2초에 1장)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="1265" width="160" height="50" as="geometry"/></mxCell><mxCell id="c68" value='&lt;b&gt;사진 서버로 전송&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;압축 이미지 + 촬영 시각&lt;/span&gt;' style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="1262" width="200" height="56" as="geometry"/></mxCell><mxCell id="c69" value="새 이동 명령&lt;br&gt;받음?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="660" y="1245" width="170" height="90" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;② 섹터 작업 (촬영 · 전송)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;whiteSpace=wrap;fontColor=#6A4BB0;" vertex="1" parent="1"><mxGeometry x="1292" y="1324" width="220" height="18" as="geometry"/></mxCell><mxCell id="c71" value='&lt;b&gt;촬영 중지&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;명령을 받으면 즉시&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="660" y="1372" width="170" height="46" as="geometry"/></mxCell><mxCell id="c72" value="다음 명령&lt;br&gt;종류?" style="rhombus;whiteSp