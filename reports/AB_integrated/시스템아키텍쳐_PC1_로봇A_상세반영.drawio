      <mxCell id="a1_c57" value="&lt;b&gt;① 탐색&lt;/b&gt;  &lt;span style=&quot;font-size:24.2px;color:#666&quot;&gt;순찰 명령 · 섹터 A1 → A4&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=28.6;fontColor=#1A1A1A;whiteSpace=wrap;fontColor=#6A4BB0;" vertex="1" parent="pc1logic"><mxGeometry x="372.0" y="83.2" width="880.0" height="39.6" as="geometry" /></mxCell><mxCell id="a1_c58" value="&lt;b&gt;명령 확인&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20.9px;color:#D62728&quot;&gt;← /robot_a/mission_cmd&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=2.2;fontSize=24.2;fontColor=#1A1A1A;arcSize=12;" vertex="1" parent="pc1logic"><mxGeometry x="86.0" y="169.0" width="308.0" height="110.0" as="geometry" /></mxCell><mxCell id="a1_c59" value="&lt;b&gt;docking?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20.9px;color:#D62728&quot;&gt;/robot_a/dock_status&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=2.2;fontSize=23.1;fontColor=#1A1A1A;" vertex="1" parent="pc1logic"><mxGeometry x="451.2" y="140.4" width="352.0" height="167.2" as="geometry" /></mxCell><mxCell id="a1_c60" value="&lt;b&gt;undock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20.9px;color:#1F5FD6&quot;&gt;→ /robot_a/undock&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=2.2;fontSize=24.2;fontColor=#1A1A1A;arcSize=12;" vertex="1" parent="pc1logic"><mxGeometry x="856.0" y="169.0" width="308.0" height="110.0" as="geometry" /></mxCell><mxCell id="a1_c61" value="&lt;b&gt;순찰 실행&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20.9px;color:#666666&quot;&gt;섹터 좌표 목록&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=2.2;fontSize=24.2;fontColor=#1A1A1A;arcSize=12;" vertex="1" parent="pc1logic"><mxGeometry x="1252.0" y="169.0" width="308.0" height="110.0" as="geometry" /></mxCell><mxCell id="a1_c62" value="&lt;b&gt;순찰 좌표로 이동&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20.9px;color:#2E7D4F&quot;&gt;→ Nav2: goal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=2.2;fontSize=24.2;fontColor=#1A1A1A;arcSize=12;" vertex="1" parent="pc1logic"><mxGeometry x="86.0" y="433.0" width="330.0" height="110.0" as="geometry" /></mxCell><mxCell id="a1_c63" value="Nav2 결과&lt;br&gt;&lt;b&gt;SUCCEEDED?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20.9px;color:#2E7D4F&quot;&gt;goal checker 판정&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=2.2;fontSize=23.1;fontColor=#1A1A1A;" vertex="1" parent="pc1logic"><mxGeometry x="460.0" y="395.6" width="374.0" height="184.8" as="geometry" /></mxCell><mxCell id="a1_c64" value="&lt;b&gt;정지 후 사진 캡처&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20.9px;color:#D62728&quot;&gt;← Bot: 카메라 → 352×352&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20.9px;color:#D62728&quot;&gt;↺ recapture_request 오면 재촬영&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=2.2;fontSize=24.2;fontColor=#1A1A1A;arcSize=12;" vertex="1" parent="pc1logic"><mxGeometry x="867.0" y="413.2" width="352.0" height="149.6" as="geometry" /></mxCell><mxCell id="a1_c65" value="&lt;b&gt;이미지 · 위치 · 섹터 · 시각&lt;br&gt;서버에 전송 (352×352)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20.9px;color:#1F5FD6&quot;&gt;→ /robot_a/detection_image&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20.9px;color:#1F5FD6&quot;&gt;→ /robot_a/capture_info&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A4BB0;strokeWidth=2.2;fontSize=24.2;fontColor=#1A1A1A;arcSize=12;" vertex="1" parent="pc1logic"><mxGeometry x="1285.0" y="411.0" width="418.0" height="154.0" as="geometry" /></mxCell><mxCell id="a1_c66" value="배터리&lt;br&gt;20% 이하?&lt;br&gt;&lt;span style=&quot;font-siz