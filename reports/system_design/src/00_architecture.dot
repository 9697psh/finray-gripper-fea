digraph Arch {
  //COMMON
  label="전체 시스템 구성 (High Level Design)"; labelloc=t; fontsize=16;
  rankdir=TB; compound=true; nodesep=0.3; ranksep=0.55; newrank=true;
  node [fontsize=11];

  subgraph cluster_A {
    label="Robot A — 순회·판단 로봇"; style="rounded,filled"; fillcolor="#f1f8f1"; color="#2e7d32"; fontsize=13;
    a_hw  [label="HW: 모바일 베이스 + LiDAR\n+ 카메라(층별 촬영) + 엣지 컴퓨터", shape=box3d, fillcolor="white"];
    a_nav [label="주행: SLAM 지도 + Nav2\n웨이포인트 순회"];
    a_vis [label="인식: YOLO + 분류기\n딸기 탐지 · 숙도 · 병해"];
    a_map [label="좌표 변환\n픽셀 → 구역-통로-층·(x, y)"];
    a_com [label="통신 클라이언트\n(ROS 2 / MQTT)"];
    a_hw -> a_nav [style=invis];
    a_vis -> a_map; a_nav -> a_map [style=dashed, label="현재 위치"]; a_map -> a_com;
    {rank=same; a_nav; a_vis}
  }

  subgraph cluster_B {
    label="Robot B — 추종·운반 로봇"; style="rounded,filled"; fillcolor="#eef5fc"; color="#1565c0"; fontsize=13;
    b_hw  [label="HW: 모바일 베이스 + LiDAR\n+ 전방·상단 카메라 + 바구니 + 디스플레이", shape=box3d, fillcolor="white"];
    b_fol [label="추종: 사람 검출 + re-ID\n+ 거리 유지 제어"];
    b_load[label="적재 확인: 상단 카메라\n격자 구획별 개수"];
    b_nav [label="주행: Nav2\n최단 경로 · 위험구역 우회"];
    b_ui  [label="온보드 디스플레이\n수확 대상 · 병해 경고 · 진행률"];
    b_com [label="통신 클라이언트"];
    b_hw -> b_fol [style=invis];
    b_fol -> b_nav; b_load -> b_com; b_com -> b_nav; b_com -> b_ui;
    {rank=same; b_fol; b_load}
  }

  subgraph cluster_S {
    label="중앙 서버 (노트북/PC)"; style="rounded,filled"; fillcolor="#f5f5f5"; color="#616161"; fontsize=13;
    s_bro [label="메시지 브로커\n(ROS 2 DDS / MQTT)"];
    s_task[label="작업 관리자\n수확 큐 · 순차/동시 모드"];
    s_zone[label="지도·구역 관리\n위험구역(keep-out) 갱신"];
    s_db  [label="DB\n수확·병해·적재 이력", shape=cylinder];
    s_api [label="API 서버\n(FastAPI · WebSocket)"];
    s_bro -> s_task; s_bro -> s_zone; s_task -> s_db; s_zone -> s_db; s_db -> s_api;
    {rank=same; s_task; s_zone}
    {rank=same; s_db; s_api}
  }

  u_w [label="작업자", shape=oval, fillcolor="#fffde7", color="#bfa100"];
  u_m [label="관리자\n웹 대시보드 · 모바일 앱", shape=oval, fillcolor="#fffde7", color="#bfa100"];

  a_com -> s_bro [label="HarvestTarget · HazardZone\nRobotState", color="#2e7d32", fontcolor="#2e7d32", penwidth=1.6];
  b_com -> s_bro [dir=both, label="↓ 수확 대상 · 위험구역 · 작업 지시\n↑ LoadEvent · RobotState", color="#1565c0", fontcolor="#1565c0", penwidth=1.6];
  s_api -> u_m [label="REST / WebSocket"];
  b_ui -> u_w [label="화면 안내"];
  u_w -> b_fol [label="따라가기", style=dashed, constraint=false];
}
